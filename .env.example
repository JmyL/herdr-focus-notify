# Optional maintainer overrides. Users should not need this file. The parser
# supports KEY=value, export KEY=value, quoted values, and unquoted inline
# comments.

# Disable notifications without unlinking the plugin.
# HERDR_FOCUS_NOTIFY_ENABLED=0

# Only blocked, done, and idle can notify; this narrows that set. Idle is
# included because some Herdr/agent combinations report a completed background
# turn as idle. Other statuses (e.g. running) never notify.
# Defaults to blocked,done,idle.
# HERDR_FOCUS_NOTIFY_STATUSES=blocked,done,idle

# Print diagnostic output to Herdr plugin logs and focus-click.log.
# HERDR_FOCUS_NOTIFY_DEBUG=1

# Override the notification backend. Defaults to linux on Linux and macOS
# alerter elsewhere. Supported values: linux, macos.
# HERDR_FOCUS_NOTIFY_NOTIFIER_BACKEND=linux

# Override the notifier executable. Defaults to notify-send on Linux and
# alerter on macOS.
# HERDR_FOCUS_NOTIFY_NOTIFIER=/opt/homebrew/bin/alerter
# HERDR_FOCUS_NOTIFY_NOTIFIER=/usr/bin/notify-send

# Open this app before focusing the Herdr pane. It also confirms that a focused
# pane has been seen before removing its pending notification, including after
# switching back to an already-active pane on macOS. Use an app name or an
# absolute .app path (paths are not shell-expanded, so ~ is treated literally).
# Linux/Sway ignores this and focuses the cached Sway container id directly.
# HERDR_FOCUS_NOTIFY_ACTIVATE_APP=kitty
# HERDR_FOCUS_NOTIFY_ACTIVATE_APP=/Applications/kitty.app

# Seconds before an unclicked alert auto-dismisses (alerter only).
# 0 keeps it until dismissed. Default 3600.
# HERDR_FOCUS_NOTIFY_TIMEOUT=3600

# Common agent icons are bundled and used automatically when the Herdr event
# includes a recognized agent name.
